# Synchronisation (GitHub Actions : Settings > Secrets and variables > Actions)
YOUTUBE_API_KEY=            # secret : clé API YouTube Data v3
YOUTUBE_CHANNEL_ID=         # variable, facultatif : identifiant UC… de la chaîne (sinon trouvé via @UNIFOOTTV)
PODCAST_RSS_URL=            # variable, facultatif : flux RSS du podcast (par défaut celui d'Anchor / Spotify for Creators)
RESEND_API_KEY=             # secret, facultatif : clé Resend pour les alertes e-mail
ALERT_EMAIL_TO=             # variable : adresse technique qui reçoit les alertes
ALERT_EMAIL_FROM=           # variable : expéditeur vérifié chez Resend, ex. "UNIFOOT TV <alertes@unifoottv.fr>"

# Site (Netlify : Site configuration > Environment variables)
SITE_URL=https://unifoottv.fr
PUBLIC_ANALYTICS_SRC=       # facultatif : script de mesure d'audience, chargé seulement après consentement
PUBLIC_ANALYTICS_DOMAIN=    # facultatif : domaine déclaré chez l'outil de mesure
