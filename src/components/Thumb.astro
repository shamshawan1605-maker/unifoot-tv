---
import type { Video } from '~/types';
import { thumbSrcset, formatDuration } from '~/lib/content';
interface Props { video: Video; ratio?: '16x9' | '9x16'; sizes?: string; eager?: boolean; showTime?: boolean; alt?: string; fallbackLabel?: string }
const { video, ratio = '16x9', sizes = '(min-width: 64rem) 22vw, (min-width: 40rem) 40vw, 78vw', eager = false, showTime = true, alt = '', fallbackLabel } = Astro.props;
const t = thumbSrcset(video);
// Extraits verticaux : miniature verticale HD de YouTube (oar2), sinon la plus grande miniature 16:9 recadrée au centre
const vertical = ratio === '9x16' && t.src.startsWith('https://i.ytimg.com/');
const src = vertical ? `https://i.ytimg.com/vi/${video.id}/oar2.jpg` : t.src;
const fallback = vertical ? t.largest : '';
---
<div class={`thumb thumb--${ratio}`}>
  {fallbackLabel && <span class="thumb__fallback" aria-hidden="true">{fallbackLabel}</span>}
  <img
    src={src}
    srcset={vertical ? undefined : t.srcset}
    sizes={vertical ? undefined : sizes}
    data-fallback={fallback || undefined}
    onload={vertical ? "if(this.naturalWidth<=120&&this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}" : undefined}
    width="480"
    height={ratio === '16x9' ? 270 : 853}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    referrerpolicy="no-referrer"
    onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}else{this.remove()}"
  />
  {showTime && <span class="thumb__time"><span class="sr-only">Durée </span>{formatDuration(video.durationSec)}</span>}
</div>
