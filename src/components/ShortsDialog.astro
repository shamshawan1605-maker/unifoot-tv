---
// Lecture des Shorts dans une fenêtre, sans quitter le site. Le clic sur l'extrait lance directement la vidéo (lecteur YouTube sans cookies publicitaires).
import Icon from './Icon.astro';
---
<dialog class="sd" aria-labelledby="sd-title">
  <div class="sd__box">
    <div class="sd__head">
      <h2 id="sd-title" class="sd__title"></h2>
      <button class="sd__close" type="button" aria-label="Fermer"><Icon name="close" size={24} /></button>
    </div>
    <div class="sd__frame">
    </div>
    <p class="sd__note">Lecture via YouTube. <a class="sd__yt" href="#" rel="noopener" target="_blank">Ouvrir sur YouTube</a></p>
  </div>
</dialog>
<style>
  .sd { padding: 0; border: 0; background: transparent; color: var(--texte); max-width: none; max-height: none; }
  .sd::backdrop { background: rgb(4 5 22 / 0.88); }
  .sd__box { width: min(24rem, 92vw); }
  .sd__head { display: flex; align-items: start; gap: 1rem; margin-bottom: 0.6rem; }
  .sd__title { font: 700 1.0625rem/1.3 var(--f-texte); flex: 1; color: #fff; }
  .sd__close { background: var(--surface); color: var(--texte); border: 0; border-radius: 50%; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; cursor: pointer; flex: none; }
  .sd__frame { position: relative; aspect-ratio: 9 / 16; max-height: 80vh; background: #000; border-radius: var(--r-m); overflow: hidden; }
  .sd__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .sd__note { margin: 0.6rem 0 0; font-size: 0.8125rem; color: #c9cbe0; text-align: center; }
  .sd__note a { color: var(--menthe); }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('.sd');
  if (dlg) {
    const frame = dlg.querySelector<HTMLElement>('.sd__frame')!;
    const title = dlg.querySelector<HTMLElement>('.sd__title')!;
    const yt = dlg.querySelector<HTMLAnchorElement>('.sd__yt')!;
    let current = '';
    const close = () => { frame.querySelector('iframe')?.remove(); dlg.close(); };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-short]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      current = a.dataset.short!;
      title.textContent = a.dataset.title || '';
      yt.href = a.href;
      frame.querySelector('iframe')?.remove();
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${current}?autoplay=1&playsinline=1&rel=0`;
      f.title = title.textContent || 'Extrait vidéo';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; web-share';
      f.allowFullscreen = true;
      frame.append(f);
      dlg.showModal();
      dlg.querySelector<HTMLButtonElement>('.sd__close')!.focus();
    });
    dlg.querySelector('.sd__close')!.addEventListener('click', close);
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  }
</script>
