---
// Lecteur YouTube chargé seulement au clic (performance + RGPD) via youtube-nocookie.com
import type { Video } from '~/types';
import Thumb from './Thumb.astro';
import Icon from './Icon.astro';
import { watchUrl } from '~/lib/content';
import PlayerScript from './PlayerScript.astro';
interface Props { video: Video; eager?: boolean }
const { video, eager = true } = Astro.props;
---
<div class="ytw">
<div class="yt" data-yt={video.id} data-title={video.title}>
  <Thumb video={video} eager={eager} showTime={false} sizes="(min-width: 64rem) 60vw, 100vw" />
  <div class="yt__overlay">
    <button class="yt__play" type="button" aria-describedby={`yt-note-${video.id}`}>
      <Icon name="play" size={34} />
      <span class="sr-only">Lire la vidéo : {video.title}</span>
    </button>
  </div>
</div>
    <p class="yt__note" id={`yt-note-${video.id}`}>
      La lecture charge le lecteur YouTube, qui peut déposer des cookies.
      <a href={watchUrl(video)} rel="noopener" target="_blank">Regarder sur YouTube</a>
    </p>
</div>

<style>
  .yt { position: relative; border-radius: var(--r-m); overflow: hidden; background: var(--marine); aspect-ratio: 16 / 9; }
  .yt :global(.thumb) { position: absolute; inset: 0; border-radius: 0; }
  .yt__overlay { position: absolute; inset: 0; display: grid; place-items: center; z-index: 4; }
  .yt__play { width: 5rem; height: 5rem; border-radius: 50%; border: 0; display: grid; place-items: center;
    background: var(--menthe); color: var(--marine); cursor: pointer; transition: transform .15s ease; padding-left: 4px; }
  .yt__play:hover { transform: scale(1.06); }
  .yt__note { margin: 0.5rem 0 0; max-width: none; font-size: 0.8125rem; line-height: 1.35; color: var(--texte-2); }
  .yt__note a { color: var(--accent); }
  .yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 5; }
</style>
<PlayerScript />
