---
// Bandeau « Ils sont passés chez UNIFOOT TV » : portraits des invités, chacun renvoie vers son émission.
import { invites } from '@config/invites';
import { videos, thumbSrcset, videoPath } from '~/lib/content';
import Icon from './Icon.astro';

const items = invites
  .map((i) => ({ ...i, v: videos.find((x) => x.id === i.video) }))
  .filter((i) => i.v)
  .map((i) => ({ ...i, img: i.photo ?? (thumbSrcset(i.v!).src as string), href: i.link ?? videoPath(i.v!), ext: !!i.link }));
---
{items.length >= 4 && (
  <section class="wrap section inv" aria-labelledby="inv-title">
    <div class="section-head">
      <h2 id="inv-title">Ils sont passés chez UNIFOOT TV</h2>
      <div class="inv__nav">
        <button type="button" class="inv__btn" data-dir="-1" aria-label="Invités précédents"><Icon name="arrow-left" size={20} /></button>
        <button type="button" class="inv__btn" data-dir="1" aria-label="Invités suivants"><Icon name="arrow-right" size={20} /></button>
      </div>
    </div>
    <ul class="inv__list">
      {items.map((i) => (
        <li>
          <a href={i.href} class="inv__card" {...(i.ext ? { target: '_blank', rel: 'noopener' } : {})}>
            <img src={i.img} alt="" width="300" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'" />
            <span class="inv__txt">
              <span class="inv__name">{i.name}</span>
              {i.role && <span class="inv__role">{i.role}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .inv__nav { display: none; gap: 0.5rem; }
  @media (min-width: 48rem) { .inv__nav { display: flex; } }
  .inv__btn { width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--trait); background: var(--fond); color: var(--texte); display: grid; place-items: center; cursor: pointer; }
  .inv__btn:hover { background: var(--marine); color: #fff; border-color: var(--marine); }
  .inv__list { list-style: none; margin: 0; padding: 0 0 0.5rem; display: grid; grid-auto-flow: column; grid-auto-columns: 10.5rem; gap: 0.9rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .inv__list::-webkit-scrollbar { display: none; }
  @media (min-width: 48rem) { .inv__list { grid-auto-columns: 12rem; } }
  .inv__list li { scroll-snap-align: start; }
  .inv__card { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: 12px; overflow: hidden; background: var(--marine); text-decoration: none; }
  .inv__card img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform .3s ease; }
  .inv__card::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(to top, rgb(10 12 44 / 0.95), transparent); }
  .inv__card:hover img { transform: scale(1.05); }
  .inv__txt { position: absolute; z-index: 2; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; display: grid; gap: 0.15rem; text-align: center; }
  .inv__name { font: 800 0.9375rem/1.2 var(--f-texte); color: #fff; }
  .inv__role { font: 600 0.75rem/1.25 var(--f-info); color: var(--menthe); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .inv__card:focus-visible { box-shadow: var(--focus); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.inv').forEach((sec) => {
    const list = sec.querySelector<HTMLElement>('.inv__list')!;
    sec.querySelectorAll<HTMLButtonElement>('.inv__btn').forEach((b) =>
      b.addEventListener('click', () => list.scrollBy({ left: Number(b.dataset.dir) * list.clientWidth * 0.8, behavior: 'smooth' })),
    );
  });
</script>
