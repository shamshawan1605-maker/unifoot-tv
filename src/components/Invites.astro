---
// Bandeau « Ils sont passés chez UNIFOOT TV » : portraits des invités, chacun renvoie vers son émission.
import { invites } from '@config/invites';
import { videos, thumbSrcset, videoPath, hasCustomPhoto } from '~/lib/content';
import Icon from './Icon.astro';
import { links } from '@config/site';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';

// ?v=… change quand la photo change, pour que les navigateurs ne gardent pas l'ancienne
const versioned = (p: string) => {
  try { return `${p}?v=${createHash('md5').update(readFileSync(join(process.cwd(), 'public', p))).digest('hex').slice(0, 8)}`; } catch { return p; }
};

const items = invites
  .map((i) => ({ ...i, v: videos.find((x) => x.id === i.video) }))
  .filter((i) => i.v && (i.photo || hasCustomPhoto(i.v))) // seuls les invités avec une vraie photo s'affichent
  .map((i) => ({ ...i, img: i.photo ? versioned(i.photo) : (thumbSrcset(i.v!).src as string), href: i.link ?? videoPath(i.v!), ext: !!i.link }));
// 3 rangées qui défilent en continu (1re et 3e vers la gauche, 2e vers la droite)
const rows = [0, 1, 2].map((r) => items.filter((_, i) => i % 3 === r));
---
{items.length >= 6 && (
  <section class="section inv" aria-labelledby="inv-title">
    <div class="wrap section-head">
      <h2 id="inv-title">Ils sont passés chez UNIFOOT TV</h2>
      <a class="more" href={links.youtube} target="_blank" rel="noopener">Tous les invités sur YouTube</a>
    </div>
    <div class="inv__rows">
      {rows.map((row, r) => (
        <div class:list={['inv__row', { 'inv__row--rev': r === 1 }]} style={`--n:${row.length};--dur:${row.length * 5}s`}>
          <ul class="inv__track">
            {[...row, ...row].map((i, k) => (
              <li aria-hidden={k >= row.length ? 'true' : undefined}>
                <a href={i.href} class="inv__card" tabindex={k >= row.length ? -1 : undefined} {...(i.ext ? { target: '_blank', rel: 'noopener' } : {})}>
                  <img src={i.img} alt="" width="300" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'" />
                  <span class="inv__txt">
                    <span class="inv__name">{i.name}</span>
                    {i.role && <span class="inv__role">{i.role}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .inv__rows { display: grid; gap: 0.9rem; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .inv__row { overflow: hidden; }
  .inv__track { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.9rem; width: max-content; animation: inv-left var(--dur) linear infinite; }
  .inv__row--rev .inv__track { animation-name: inv-right; }
  .inv__rows:hover .inv__track, .inv__rows:focus-within .inv__track { animation-play-state: paused; }
  @keyframes inv-left { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 0.45rem)); } }
  @keyframes inv-right { from { transform: translateX(calc(-50% - 0.45rem)); } to { transform: translateX(0); } }
  .inv__track li { flex: none; width: 9.5rem; }
  @media (min-width: 48rem) { .inv__track li { width: 11rem; } }
  .inv__card { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: 12px; overflow: hidden; background: var(--marine); text-decoration: none; }
  .inv__card img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform .3s ease; }
  .inv__card::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(to top, rgb(10 12 44 / 0.95), transparent); }
  .inv__card:hover img { transform: scale(1.05); }
  .inv__txt { position: absolute; z-index: 2; left: 0.6rem; right: 0.6rem; bottom: 0.65rem; display: grid; gap: 0.15rem; text-align: center; }
  .inv__name { font: 800 0.9375rem/1.2 var(--f-texte); color: #fff; }
  .inv__role { font: 600 0.75rem/1.25 var(--f-info); color: var(--menthe); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .inv__card:focus-visible { box-shadow: var(--focus); }
  /* Animations réduites : rangées défilables à la main */
  @media (prefers-reduced-motion: reduce) {
    .inv__track { animation: none; }
    .inv__row { overflow-x: auto; }
    .inv__track li[aria-hidden='true'] { display: none; }
  }
</style>
