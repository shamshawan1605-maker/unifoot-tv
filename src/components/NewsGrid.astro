---
import type { News } from '~/lib/news';
import NewsCard from './NewsCard.astro';
interface Props { items: News[]; page?: number; pages?: number }
const { items, page = 1, pages = 1 } = Astro.props;
const href = (n: number) => (n === 1 ? '/actualites/' : `/actualites/page/${n}/`);
---
<div class="ng">{items.map((n) => <NewsCard news={n} headingLevel="h2" />)}</div>
{pages > 1 && (
  <nav class="pager" aria-label="Pages des actualités">
    {page > 1 && <a href={href(page - 1)} rel="prev">Précédent<span class="sr-only">e page</span></a>}
    {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (n === page ? <span aria-current="page">{n}</span> : <a href={href(n)}><span class="sr-only">Page </span>{n}</a>))}
    {page < pages && <a href={href(page + 1)} rel="next">Suivant<span class="sr-only">e page</span></a>}
  </nav>
)}
<style>
  .ng { display: grid; gap: 2rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
