---
// Emplacement partenaire. Vendu : logo + texte + lien (signalé « Partenaire »). Libre : annonce maison.
import type { Sponsor } from '@config/sponsors';
import Icon from './Icon.astro';
import { links } from '@config/site';
import { audienceHighlights } from '@config/audience';
interface Props { sponsor: Sponsor | null; variant?: 'banner' | 'inline' | 'presented'; where?: string; seed?: number }
const { sponsor, variant = 'inline', where = '', seed = 0 } = Astro.props;
const reach = audienceHighlights[0];
const house = seed % 2 === 0
  ? { titre: where ? `Votre marque associée à ${where}` : 'Votre marque devant le foot amateur', texte: `${reach.value} ${reach.label}. Des emplacements réservés aux marques du sport.`, lien: '/partenaires/', bouton: 'Devenir partenaire', externe: false }
  : { titre: 'Soutiens le média du foot amateur', texte: "UNIFOOT TV est indépendant. Ton soutien aide à produire l'émission chaque semaine.", lien: links.tipeee, bouton: 'Soutenir sur Tipeee', externe: true };
---
{variant === 'presented' ? (
  sponsor ? (
    <a class="sp-pres" href={sponsor.lien} rel="sponsored noopener" target="_blank">
      <span class="sp-pres__l">Présenté par</span>
      {sponsor.logo ? <img src={sponsor.logo} alt={sponsor.nom} height="28" loading="lazy" /> : <strong>{sponsor.nom}</strong>}
    </a>
  ) : (
    <a class="sp-pres sp-pres--libre" href="/partenaires/"><span class="sp-pres__l">Votre marque pour présenter cette émission ?</span></a>
  )
) : (
  <aside class:list={['sp', `sp--${variant}`, { 'sp--maison': !sponsor }]} aria-label={sponsor ? `Partenaire : ${sponsor.nom}` : 'Annonce UNIFOOT TV'}>
    <span class="sp__tag">{sponsor ? 'Partenaire' : 'UNIFOOT TV'}</span>
    {sponsor ? (
      <>
        <span class="sp__logo">{sponsor.logo ? <img src={sponsor.logo} alt={sponsor.nom} height="40" loading="lazy" /> : <strong>{sponsor.nom}</strong>}</span>
        <p class="sp__txt">{sponsor.texte}</p>
        <a class="btn btn--small" href={sponsor.lien} rel="sponsored noopener" target="_blank">{sponsor.bouton ?? 'Découvrir'}</a>
      </>
    ) : (
      <>
        <p class="sp__txt"><strong>{house.titre}</strong><span>{house.texte}</span></p>
        <a class="btn btn--small" href={house.lien} {...(house.externe ? { rel: 'noopener', target: '_blank' } : {})}>{house.externe && <Icon name="heart" size={16} />}{house.bouton}</a>
      </>
    )}
  </aside>
)}
<style>
  .sp { position: relative; display: grid; gap: 0.75rem 1.25rem; align-items: center; padding: 1.1rem 1.25rem; border: 1px solid var(--trait); border-radius: var(--r-m); background: var(--fond-2); }
  .sp--banner { grid-template-columns: auto 1fr auto; }
  @media (max-width: 47.99rem) { .sp--banner { grid-template-columns: 1fr; } }
  .sp--inline { margin-block: 2rem; }
  .sp--maison { background: color-mix(in srgb, var(--menthe) 14%, #fff); border-color: color-mix(in srgb, var(--menthe) 50%, #fff); }
  .sp__tag { position: absolute; top: -0.6rem; left: 1rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: var(--fond); border: 1px solid var(--trait);
    font: 700 0.6875rem/1.2 var(--f-info); color: var(--texte-2); letter-spacing: 0.04em; text-transform: uppercase; }
  .sp__logo img { height: 2.5rem; width: auto; }
  .sp__logo strong { font: 800 1.125rem/1 var(--f-titre); }
  .sp__txt { margin: 0; font-size: var(--t-s); line-height: 1.45; }
  .sp__txt strong { display: block; font: 800 1rem/1.3 var(--f-titre); margin-bottom: 0.15rem; }
  .sp__txt span { color: var(--texte-2); }
  .sp .btn { justify-self: start; }
  .sp-pres { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1rem; padding: 0.45rem 0.8rem; border: 1px solid var(--trait); border-radius: 999px; text-decoration: none; max-width: 100%; }
  .sp-pres__l { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-pres img { height: 1.6rem; width: auto; }
  .sp-pres__l { font: 600 0.8125rem/1.2 var(--f-info); color: var(--texte-2); }
  .sp-pres--libre:hover { border-color: var(--texte); }
</style>
