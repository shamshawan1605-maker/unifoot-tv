---
// Onglets pour passer d'une émission à l'autre (Kick in the Foot, Entre 2, etc.)
import { activeShows, episodesOfShow } from '~/lib/content';
interface Props { current: string }
const { current } = Astro.props;
const tabs = activeShows.map((s) => ({ slug: s.slug, name: s.name, count: episodesOfShow(s.slug).length }));
---
<nav class="tabs" aria-label="Choisir une émission">
  <ul>
    {tabs.map((t) => (
      <li>
        <a href={`/emissions/${t.slug}/`} aria-current={t.slug === current ? 'page' : undefined}>
          {t.name}<span class="tabs__n">{t.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .tabs { border-bottom: 1px solid var(--trait); margin-bottom: 1.5rem; }
  .tabs ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  .tabs ul::-webkit-scrollbar { display: none; }
  .tabs a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1rem; white-space: nowrap; text-decoration: none; font: 800 0.9375rem/1 var(--f-info); color: var(--texte-2); border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .tabs a:hover { color: var(--texte); }
  .tabs a[aria-current='page'] { color: var(--texte); border-bottom-color: var(--menthe); }
  .tabs__n { font: 700 0.75rem/1 var(--f-info); padding: 0.25rem 0.45rem; border-radius: 999px; background: var(--surface); color: var(--texte-2); }
  .tabs a[aria-current='page'] .tabs__n { background: var(--marine); color: #fff; }
</style>
