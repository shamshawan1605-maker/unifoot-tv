---
// Emplacement publicitaire AdSense, signalé « Publicité ». N'affiche rien tant que l'AdSense n'est pas configuré (config/site.ts).
// mid = true : le bloc se place au milieu de l'article (avant le 2e intertitre), sinon il reste où il est.
import { google } from '@config/site';
interface Props { slot?: string; mid?: boolean }
const { slot = google.slotActu, mid = false } = Astro.props;
const on = Boolean(google.adsenseClient && slot);
---
{on && (
  <aside class="ad" aria-label="Publicité" data-mid={mid ? '' : undefined}>
    <span class="ad__tag">Publicité</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={google.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
  </aside>
)}
<style>
  .ad { margin-block: 2.25rem; padding-top: 0.75rem; border-top: 1px solid var(--trait); border-bottom: 1px solid var(--trait); padding-bottom: 0.75rem; min-height: 17rem; }
  .ad__tag { display: block; margin-bottom: 0.6rem; font: 700 0.6875rem/1 var(--f-info); letter-spacing: 0.08em; text-transform: uppercase; color: var(--texte-2); text-align: center; }
  .ad ins { min-height: 15rem; }
  .ad:has(ins[data-ad-status="unfilled"]) { display: none; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.ad').forEach((ad) => {
    if (ad.dataset.done) return;
    ad.dataset.done = '1';
    if (ad.hasAttribute('data-mid')) {
      const prose = ad.previousElementSibling?.matches('.prose') ? ad.previousElementSibling : document.querySelector('.art__text');
      const h2s = prose?.querySelectorAll(':scope > h2');
      const ps = prose?.querySelectorAll(':scope > p');
      const target = h2s && h2s.length >= 2 ? h2s[1] : ps && ps.length >= 4 ? ps[2].nextElementSibling : null;
      if (target) target.before(ad);
    }
    try { ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({}); } catch {}
  });
</script>
