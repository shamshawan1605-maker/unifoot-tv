---
import Base from '~/layouts/Base.astro';
import Thumb from '~/components/Thumb.astro';
import PlayerScript from '~/components/PlayerScript.astro';
import Scoreboard from '~/components/Scoreboard.astro';
import OverlayCard from '~/components/OverlayCard.astro';
import Bands from '~/components/Bands.astro';
import SponsorSlot from '~/components/SponsorSlot.astro';
import { placements } from '@config/sponsors';
import EpisodeCard from '~/components/EpisodeCard.astro';
import ShortCard from '~/components/ShortCard.astro';
import ShortsDialog from '~/components/ShortsDialog.astro';
import NewsCard from '~/components/NewsCard.astro';
import Newsletter from '~/components/Newsletter.astro';
import Icon from '~/components/Icon.astro';
import { site, links, podcastPlatforms } from '@config/site';
import { audienceHighlights } from '@config/audience';
import { latestEpisode, episodes, shorts, activeShows, episodesOfShow, activeThemes, contentOfTheme, videoPath, showOf, formatDate, formatShortDate, durationLabel, thumbSrcset, fr, watchUrl } from '~/lib/content';
import { podcastSeriesLd } from '~/lib/seo';
import { allShows } from '@config/shows';
import { getNews, newsPath } from '~/lib/news';

const hero = latestEpisode;
const heroShow = hero ? showOf(hero) : undefined;
const listenHref = hero?.podcast?.url || links.spotify;
// La semaine de l'émission : 4 parties du mercredi au samedi (heure de Paris)
const parisDay = (iso: string) => new Date(new Date(iso).toLocaleString('en-US', { timeZone: 'Europe/Paris' }));
const partNames: Record<number, string> = { 3: 'Avant-match', 4: 'Première période', 5: 'Deuxième période', 6: 'Prolongations' };
const dayNames = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const mainEps = episodesOfShow(allShows[0].slug);
let week: { day: number; video?: (typeof episodes)[number] }[] = [];
let weekIsCurrent = true;
let weekLabel = '';
if (hero && hero.show === allShows[0].slug) {
  const h = parisDay(hero.publishedAt);
  const wed = new Date(h);
  wed.setHours(0, 0, 0, 0);
  wed.setDate(h.getDate() - ((h.getDay() - 3 + 7) % 7));
  const end = new Date(wed); end.setDate(wed.getDate() + 7);
  const inWeek = mainEps.filter((v) => { const d = parisDay(v.publishedAt); return d >= wed && d < end; });
  weekIsCurrent = parisDay(new Date().toISOString()) < end;
  weekLabel = wed.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
  week = [3, 4, 5, 6].map((day) => ({ day, video: [...inWeek].reverse().find((v) => parisDay(v.publishedAt).getDay() === day) }));
}
const weekIds = new Set(week.map((w) => w.video?.id).filter(Boolean));
const others = episodes.filter((v) => v.id !== hero?.id && !weekIds.has(v.id));
const dontMiss = others.slice(0, 5);
const news = await getNews();
const ranked = news.length
  ? news.slice(0, 5).map((n) => ({ href: newsPath(n), title: n.data.titre, meta: formatShortDate(n.data.date.toISOString()), img: n.data.image }))
  : [...episodes].filter((v) => v.viewCount !== undefined).sort((a, b) => (b.viewCount ?? 0) - (a.viewCount ?? 0)).slice(0, 5)
      .map((v) => ({ href: videoPath(v), title: v.title, meta: showOf(v).name, img: thumbSrcset(v).src as string | undefined }));
const rankTitle = news.length ? "L'actu" : 'Les plus regardés';
const topShorts = shorts.slice(0, 12);
const topRow = (news.length
  ? news.slice(0, 4).map((n) => ({ href: newsPath(n), title: n.data.titre, meta: `Actu / ${formatShortDate(n.data.date.toISOString())}`, img: n.data.image, short: '' }))
  : shorts.slice(0, 4).map((v) => ({ href: watchUrl(v), title: v.title, meta: `Extrait / ${formatShortDate(v.publishedAt)}`, img: thumbSrcset(v).src, short: v.id })));
// Les plus regardées : uniquement des vidéos qui ne sont pas déjà plus haut sur la page
const shownIds = new Set([hero?.id, ...weekIds, ...dontMiss.map((v) => v.id)]);
const popular = others.filter((v) => !shownIds.has(v.id)).sort((a, b) => (b.viewCount ?? 0) - (a.viewCount ?? 0) || b.publishedAt.localeCompare(a.publishedAt)).slice(0, 4);
const tileColors = ['menthe', 'jaune', 'bleu', 'corail', 'sarcelle'];
const badgeFor = (i: number) => ['', 'menthe', 'jaune', 'corail', 'sarcelle'][i % 5];
---
<Base
  title={`${site.name} : le média du football amateur`}
  rawTitle
  description={site.description}
  path="/"
  jsonLd={[podcastSeriesLd()]}
  preloadImage={hero ? { srcset: thumbSrcset(hero).srcset, sizes: '(min-width: 64rem) 66vw, 100vw' } : undefined}
>
  <h1 class="sr-only">UNIFOOT TV, le média du football amateur</h1>

  {topRow.length > 0 && (
    <nav class="wrap toprow" aria-label="En ce moment">
      <ul>
        {topRow.map((t) => (
          <li>
            <a href={t.href} data-short={t.short || undefined} data-title={t.short ? t.title : undefined}>
              <span class="toprow__img">{t.img && <img src={t.img} alt="" width="64" height="64" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}</span>
              <span><span class="toprow__t">{fr(t.title)}</span><span class="toprow__m">{t.meta}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- À la une : dernier épisode + rendez-vous du mercredi -->
  <section class="une wrap" aria-labelledby="une-title">
    {hero ? (
      <article class="une__main">
        <div class="yt une__media" data-yt={hero.id} data-title={hero.title}>
          <Thumb video={hero} eager showTime={false} sizes="(min-width: 64rem) 66vw, 100vw" />
          <button class="yt__play une__play" type="button"><Icon name="play" size={30} /><span class="sr-only">Lire : {hero.title}</span></button>
        </div>
        <div class="une__txt">
          <p class="une__meta">
            <span class="badge">{heroShow!.name}</span>
            <span class="badge badge--menthe">Nouvel épisode</span>
            <time datetime={hero.publishedAt}>{formatDate(hero.publishedAt)}</time>
            <span>{durationLabel(hero.durationSec)}</span>
          </p>
          <h2 id="une-title" class="une__title"><a href={videoPath(hero)}>{fr(hero.title)}</a></h2>
          {hero.guest && <p class="une__guest">Invité : {hero.guest}</p>}
          <div class="une__ctas">
            <a class="btn btn--menthe" href={watchUrl(hero)} data-play={hero.id}><Icon name="play" size={20} />Regarder</a>
            <a class="btn btn--jaune" href={listenHref} rel="noopener" target="_blank"><Icon name="listen" size={20} />Écouter</a>
          </div>
          <p class="une__note">La lecture charge le lecteur YouTube, qui peut déposer des cookies.</p>
        </div>
      </article>
    ) : (
      <div class="une__main une__main--empty sombre">
        <h2 id="une-title" class="une__title">Kick in the Foot, l'émission du foot amateur</h2>
        <p>{site.promise}</p>
        <div class="une__ctas">
          <a class="btn btn--menthe" href={links.youtube} rel="noopener" target="_blank"><Icon name="play" size={20} />Regarder</a>
          <a class="btn btn--jaune" href={links.spotify} rel="noopener" target="_blank"><Icon name="listen" size={20} />Écouter</a>
        </div>
      </div>
    )}

    <aside class="une__side sombre" aria-label="Le rendez-vous de la semaine">
      <Scoreboard />
      {week.length > 0 && (
        <div class="onair">
          <p class="onair__h">{weekIsCurrent ? `Cette semaine dans ${allShows[0].name}` : `${allShows[0].name}, semaine du ${weekLabel}`}</p>
          <ol>
            {week.map((w) => (
              <li class:list={{ 'onair__now': w.video?.id === hero?.id, 'onair__soon': !w.video }}>
                {w.video ? (
                  <a href={videoPath(w.video)}>
                    <span class="onair__part">{partNames[w.day]}</span>
                    <span><span class="onair__t">{fr(w.video.title)}</span><span class="onair__m">{dayNames[w.day]}{w.video.id === hero?.id ? ' / À la une' : ''}</span></span>
                  </a>
                ) : (
                  <div class="onair__wait">
                    <span class="onair__part">{partNames[w.day]}</span>
                    {weekIsCurrent
                      ? <span><span class="onair__t">À venir</span><span class="onair__m">{dayNames[w.day]} à 18h</span></span>
                      : <span><span class="onair__t">Pas de diffusion</span><span class="onair__m">{dayNames[w.day]}</span></span>}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </section>

  <Bands />

  <!-- À ne pas manquer + classement -->
  {dontMiss.length >= 3 && (
    <section class="section wrap dm" aria-labelledby="dm-title">
      <div class="dm__main">
        <div class="section-head">
          <h2 id="dm-title">À ne pas manquer</h2>
          <a class="more" href="/emissions/">Toutes les émissions</a>
        </div>
        <div class="dm__grid">
          {dontMiss.map((v, i) => <OverlayCard video={v} size={i === 0 ? 'big' : 'small'} badgeColor={badgeFor(i)} sizes={i === 0 ? '(min-width: 64rem) 30vw, 100vw' : '(min-width: 64rem) 18vw, 50vw'} />)}
        </div>
      </div>
      {ranked.length > 0 && (
        <aside class="rank" aria-labelledby="rank-title">
          <div class="rank__head">
            <h2 id="rank-title">{rankTitle}</h2>
            <a class="more" href={news.length ? '/actualites/' : '/emissions/'}>Tout voir</a>
          </div>
          <ol>
            {ranked.map((r) => (
              <li><a href={r.href}><span class="rank__t">{fr(r.title)}</span><span class="rank__m">{r.meta}</span>{r.img && <img class="rank__img" src={r.img} alt="" width="72" height="54" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </section>
  )}

  <div class="wrap"><SponsorSlot sponsor={placements.accueil} variant="banner" seed={0} /></div>

  <!-- Vidéos populaires : une grande + liste -->
  {popular.length >= 3 && (
    <section class="wrap section pop" aria-labelledby="pop-title">
      <div class="section-head">
        <h2 id="pop-title">Les plus regardées</h2>
        <a class="more" href="/emissions/">Toutes les vidéos</a>
      </div>
      <div class="pop__grid">
        <OverlayCard video={popular[0]} size="big" badgeColor="corail" sizes="(min-width: 64rem) 55vw, 100vw" />
        <ul class="pop__list">
          {popular.slice(1).map((v) => (
            <li>
              <a href={videoPath(v)}>
                <span class="pop__thumb"><Thumb video={v} sizes="10rem" /></span>
                <span><span class="pop__t">{fr(v.title)}</span><span class="pop__m">{showOf(v).name} / {formatShortDate(v.publishedAt)}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Extraits -->
  {topShorts.length > 0 && (
    <section class="section shorts" aria-labelledby="extraits-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="extraits-title">Les extraits qui font parler</h2>
            <p>Les moments forts de l'émission, en format court.</p>
          </div>
          <a class="more" href="/extraits/">Tous les extraits</a>
        </div>
        <div class="rail rail--9x16">
          {topShorts.map((v) => <ShortCard video={v} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Audience + plateformes -->
  <section class="wrap stats" aria-label="Où nous suivre">
    <div class="stats__in">
      <div class="stats__where">
        <p class="stats__h">Disponible sur</p>
        <ul>
          <li><a href={links.youtube} rel="noopener" target="_blank"><Icon name="youtube" size={22} />YouTube</a></li>
          {podcastPlatforms.map((p) => <li><a href={p.url} rel="noopener" target="_blank"><Icon name={{ Spotify: 'spotify', 'Apple Podcasts': 'apple', Deezer: 'deezer', 'Amazon Music': 'amazon' }[p.name] ?? 'listen'} size={22} />{p.name}</a></li>)}
        </ul>
      </div>
      <dl class="stats__nums">
        {audienceHighlights.map((a) => <div><dt>{a.label}</dt><dd>{a.value}</dd></div>)}
        {episodes.length > 0 && <div><dt>épisodes en ligne</dt><dd>{episodes.length}</dd></div>}
      </dl>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section" aria-labelledby="news-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="news-title">L'actu du foot amateur</h2>
          <a class="more" href="/actualites/">Toute l'actu</a>
        </div>
        <div class="news-home">{news.slice(0, 4).map((n) => <NewsCard news={n} />)}</div>
      </div>
    </section>
  )}

  <!-- Thèmes : mosaïque de couleurs -->
  {activeThemes.length > 0 && (
    <section class="section" aria-labelledby="themes-title">
      <div class="wrap">
        <div class="section-head themes-head">
          <h2 id="themes-title">Explore les thèmes</h2>
          <svg class="sticker" viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="sticker-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
            <circle cx="60" cy="60" r="58" fill="#ffd23f" stroke="#0a0c2c" stroke-width="3" />
            <text font-size="11" font-weight="800" fill="#0a0c2c"><textPath href="#sticker-circle" textLength="272" lengthAdjust="spacing">FOOT AMATEUR • UNIFOOT TV • </textPath></text>
            <circle cx="60" cy="60" r="20" fill="#0a0c2c" /><path d="M55 50v20l16-10z" fill="#4fffbe" />
          </svg>
        </div>
        <ul class="mosaic">
          {activeThemes.map((t, i) => {
            const c = contentOfTheme(t.slug);
            const pic = c.episodes[0];
            return (
              <li class={`mosaic__tile tile--${tileColors[i % tileColors.length]} ${i === 0 || i === 3 ? 'mosaic__tile--wide' : ''}`}>
                <a href={`/themes/${t.slug}/`}>
                  <span class="mosaic__name">{t.name}</span>
                  <span class="mosaic__count">{t.count} {t.count > 1 ? 'vidéos' : 'vidéo'}</span>
                  {pic && <img class="mosaic__pic" src={thumbSrcset(pic).src} alt="" width="320" height="180" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Émissions -->
  {activeShows.length > 0 && (
    <section class="section shows" aria-labelledby="shows-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="shows-title">Nos émissions</h2>
          <a class="more" href="/emissions/">Toutes les émissions</a>
        </div>
        <ul class="shows__list">
          {activeShows.map((s, i) => {
            const eps = episodesOfShow(s.slug);
            return (
              <li class="show-row">
                <a class="show-row__link" href={`/emissions/${s.slug}/`}>
                  <span class={`show-row__num tile--${tileColors[i % tileColors.length]}`}>{eps.length}<small>{eps.length > 1 ? 'épisodes' : 'épisode'}</small></span>
                  <span class="show-row__txt">
                    <span class="show-row__name">{s.name}</span>
                    <span class="show-row__kicker">{s.kicker}{s.schedule ? `. ${s.schedule}.` : '.'}</span>
                  </span>
                </a>
                <div class="show-row__thumbs" aria-hidden="true">
                  {eps.slice(0, 3).map((v) => <img src={thumbSrcset(v).src} alt="" width="240" height="135" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'" />)}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Appel à témoigner -->
  <section class="wrap cta-wrap" aria-labelledby="testify-title">
    <div class="cta sombre">
      <div class="cta__txt">
        <h2 id="testify-title">Ton club a une histoire&nbsp;? Raconte-la.</h2>
        <p>Éducateur, arbitre, parent, bénévole ou joueur : l'émission se nourrit de vos témoignages et de vos sujets.</p>
        <ul class="cta__choices">
          <li><a class="btn btn--menthe" href="/participer/?type=temoignage"><Icon name="mic" size={18} />Témoigner</a></li>
          <li><a class="btn btn--ghost" href="/participer/?type=sujet">Proposer un sujet</a></li>
          <li><a class="btn btn--ghost" href="/participer/?type=invite">Venir sur le plateau</a></li>
        </ul>
      </div>
      <div class="cta__art" aria-hidden="true">
        <span class="cta__sun"></span>
        <svg class="cta__mic" viewBox="0 0 24 24"><rect x="8" y="2" width="8" height="13" rx="4" fill="#4fffbe"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4M8 22h8" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
    </div>
  </section>

  <Newsletter withSupport />
  <ShortsDialog />
  <PlayerScript />
</Base>

<style>
  /* ---- Bandeau du moment ---- */
  .toprow ul { list-style: none; margin: 0; padding: 1rem 0 0; display: grid; gap: 0.75rem; grid-auto-flow: column; grid-auto-columns: minmax(15rem, 80%); overflow-x: auto; scrollbar-width: none; }
  @media (min-width: 64rem) { .toprow ul { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; } }
  .toprow a { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; align-items: center; padding: 0.6rem; border: 1px solid var(--trait); border-radius: 10px; text-decoration: none; height: 100%; box-shadow: 0 1px 2px rgb(10 12 44 / 0.04); }
  .toprow a:hover { border-color: var(--texte); }
  .toprow__img { width: 3.5rem; height: 3.5rem; border-radius: 8px; overflow: hidden; background: var(--marine); }
  .toprow__img img { width: 100%; height: 100%; object-fit: cover; }
  .toprow__t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font: 700 0.875rem/1.3 var(--f-texte); }
  .toprow__m { display: block; margin-top: 0.2rem; font: 500 0.75rem/1.2 var(--f-info); color: var(--texte-2); }

  /* ---- Vidéos populaires ---- */
  .pop__grid { display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .pop__grid { grid-template-columns: 1.6fr 1fr; } }
  .pop__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; align-content: start; }
  .pop__list a { display: grid; grid-template-columns: 10rem 1fr; gap: 0.9rem; align-items: center; text-decoration: none; }
  .pop__thumb :global(.thumb) { aspect-ratio: 16 / 9; }
  .pop__t { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font: 700 0.9375rem/1.35 var(--f-texte); }
  .pop__m { display: block; margin-top: 0.3rem; font: 500 0.8125rem/1.2 var(--f-info); color: var(--texte-2); }
  .pop__list a:hover .pop__t { color: var(--accent); }

  /* ---- À la une ---- */
  .une { display: grid; gap: 1.25rem; padding-top: 1.25rem; }
  @media (min-width: 64rem) { .une { grid-template-columns: minmax(0, 2.1fr) minmax(19rem, 1fr); padding-top: 1.75rem; } }
  .une__main { position: relative; display: grid; gap: 1rem; }
  .une__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--marine); border-radius: var(--r-m); }
  .une__media :global(.thumb) { position: absolute; inset: 0; border-radius: 0; }
  .une__badge { position: absolute; z-index: 4; left: 1rem; top: 1rem; }
  .une__play { position: absolute; z-index: 4; inset: 0; margin: auto; width: 4.75rem; height: 4.75rem; border-radius: 50%; border: 0; display: grid; place-items: center;
    background: var(--menthe); color: var(--marine); cursor: pointer; padding-left: 4px; box-shadow: 0 0 0 10px rgb(79 255 190 / 0.25); transition: transform .15s ease; }
  .une__play:hover { transform: scale(1.06); }
  .une__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; margin: 0; font: 600 var(--t-xs)/1.3 var(--f-info); color: var(--texte-2); }
  .une__title { font-size: var(--t-hero); margin-top: 0.6rem; max-width: 26ch; }
  .une__title a { text-decoration: none; }
  .une__guest { font: 700 var(--t-m)/1.3 var(--f-info); color: var(--accent); margin: 0.5rem 0 0; }
  .une__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.1rem; }
  .une__ctas .btn { flex: 1 1 9rem; min-height: 3.25rem; }
  .une__note { font-size: 0.75rem; color: var(--texte-2); margin: 0.6rem 0 0; }
  @media (min-width: 48rem) { .une__ctas .btn { flex: 0 0 auto; min-width: 11rem; } }
  /* La vignette YouTube porte déjà son titre : on ne pose rien dessus, le texte vient dessous */
  @media (min-width: 64rem) {
    .une__title { font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem); max-width: 32ch; }
  }
  .une__main--empty { padding: 2.5rem 2rem; border-radius: var(--r-m); }
  .une__main--empty p { color: var(--texte-2); font-size: var(--t-l); margin-top: 1rem; }

  .une__side { border-radius: var(--r-m); padding: 1.25rem; display: grid; gap: 1.5rem; align-content: start; }
  .onair__h { font: 700 0.9375rem/1 var(--f-info); color: #fff; margin: 0 0 0.4rem; }
  .onair ol { list-style: none; margin: 0; padding: 0; }
  .onair li + li { border-top: 1px solid var(--trait); }
  .onair a, .onair__wait { display: grid; grid-template-columns: 6.25rem 1fr; gap: 0.75rem; align-items: center; padding: 0.7rem 0; text-decoration: none; }
  .onair__part { align-self: start; justify-self: start; padding: 0.3rem 0.5rem; border-radius: 4px; background: var(--surface); font: 700 0.6875rem/1.2 var(--f-info); color: var(--texte); text-align: center; }
  .onair__now .onair__part { background: var(--menthe); color: var(--marine); }
  .onair__soon .onair__t { color: var(--texte-2); font-weight: 600; }
  .onair__t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font: 700 0.875rem/1.3 var(--f-texte); }
  .onair__m { display: block; margin-top: 0.2rem; font: 600 0.75rem/1.2 var(--f-info); color: var(--texte-2); }
  .onair a:hover .onair__t { color: var(--accent); }

  /* ---- À ne pas manquer ---- */
  .dm { display: grid; gap: 2.5rem; }
