---
import Base from '~/layouts/Base.astro';
import EpisodeCard from '~/components/EpisodeCard.astro';
import { activeShows, episodesOfShow } from '~/lib/content';
import { podcastSeriesLd } from '~/lib/seo';
import { links } from '@config/site';
const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Émissions' }];
---
<Base title="Les émissions" description="Kick in the Foot, Entre 2, Au cœur d'une séance : toutes les émissions d'UNIFOOT TV sur le football amateur, en vidéo et en podcast." breadcrumbs={crumbs} jsonLd={[podcastSeriesLd()]}>
  <header class="wrap page-head">
    <h1>Les émissions</h1>
    <p>Débats, interviews et immersions : choisis ton format.</p>
  </header>
  {activeShows.length === 0 && (
    <p class="wrap section" style="padding-top:0"><a class="btn" href={links.youtube} rel="noopener" target="_blank">Voir les émissions sur YouTube</a></p>
  )}
  {activeShows.map((s, i) => {
    const eps = episodesOfShow(s.slug);
    return (
      <section class:list={['section', { alt: i % 2 === 1 }]} aria-labelledby={`s-${s.slug}`}>
        <div class="wrap">
          <div class="section-head">
            <div>
              <h2 id={`s-${s.slug}`}><a href={`/emissions/${s.slug}/`}>{s.name}</a></h2>
              <p>{s.kicker}{s.schedule ? `. ${s.schedule}.` : '.'}</p>
            </div>
            <a class="more" href={`/emissions/${s.slug}/`}>Les {eps.length} épisodes</a>
          </div>
          <div class="rail rail--16x9">
            {eps.slice(0, 8).map((v) => <EpisodeCard video={v} showShow={false} />)}
          </div>
        </div>
      </section>
    );
  })}
</Base>
<style>
  h2 a { text-decoration: none; }
  .alt { background: var(--fond-2); }
</style>
