---
import Base from '~/layouts/Base.astro';
import ShortCard from '~/components/ShortCard.astro';
import ShortsDialog from '~/components/ShortsDialog.astro';
import Icon from '~/components/Icon.astro';
import { shorts, themeBySlug } from '~/lib/content';
import { links } from '@config/site';
const used = [...new Set(shorts.flatMap((s) => s.themes))].map((t) => themeBySlug.get(t)!).filter(Boolean);
const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Extraits' }];
---
<Base title="Les meilleurs extraits en vidéo courte" description="Les meilleurs moments de Kick in the Foot et des émissions UNIFOOT TV en format court : débats, coups de gueule et témoignages du foot amateur." breadcrumbs={crumbs} noindex={shorts.length === 0}>
  <header class="wrap page-head">
    <h1>Les extraits</h1>
    <p>Les moments forts des émissions, en moins de 3 minutes.</p>
  </header>
  <section class="wrap section" style="padding-top:0" aria-label="Extraits">
    {shorts.length === 0 ? (
      <p>Les extraits sont publiés chaque semaine sur nos réseaux. <a href={links.tiktok} rel="noopener" target="_blank">Voir sur TikTok</a></p>
    ) : (
      <>
        {used.length > 1 && (
          <div class="filters" role="group" aria-label="Filtrer par thème">
            <button class="chip" type="button" aria-pressed="true" data-filter="">Tous</button>
            {used.map((t) => <button class="chip" type="button" aria-pressed="false" data-filter={t.slug}>{t.name}</button>)}
          </div>
        )}
        <p class="sr-only" aria-live="polite" id="filter-status"></p>
        <ul class="grid-9x16 shorts-grid">
          {shorts.map((v) => <li data-themes={v.themes.join(' ')}><ShortCard video={v} /></li>)}
        </ul>
        <p class="more-wrap"><button class="btn btn--ink" type="button" id="more-shorts" hidden>Voir plus d'extraits</button></p>
        <p class="follow"><a class="btn btn--ghost" href={links.tiktok} rel="noopener" target="_blank"><Icon name="tiktok" size={18} />Suivre sur TikTok</a></p>
      </>
    )}
  </section>
  <ShortsDialog />
</Base>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .shorts-grid { list-style: none; margin: 0; padding: 0; }
  .shorts-grid li[hidden], .shorts-grid li.is-more { display: none; }
  .follow { margin-top: 1.5rem; text-align: center; }
  .more-wrap { margin-top: 2rem; text-align: center; }
  /* Téléphone : les filtres sur une seule ligne qui défile */
  @media (max-width: 47.99rem) {
    .filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gouttiere) * -1); padding-inline: var(--gouttiere); }
    .filters::-webkit-scrollbar { display: none; }
    .filters .chip { flex: none; }
  }
</style>
<script>
  // Les extraits s'affichent par paquets : la page reste légère, « Voir plus » charge la suite
  const STEP = 24;
  let limit = STEP;
  let current = '';
  const more = document.getElementById('more-shorts') as HTMLButtonElement | null;
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.shorts-grid li');
  const status = document.getElementById('filter-status')!;
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      current = b.dataset.filter!;
      limit = STEP;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const n = apply();
      status.textContent = `${n} extrait${n > 1 ? 's' : ''}`;
    }),
  );
  function apply() {
    let n = 0;
    items.forEach((li) => {
      const match = !current || (li.dataset.themes || '').split(' ').includes(current);
      if (match) n++;
      li.hidden = !match;
      li.classList.toggle('is-more', match && n > limit); // masqué en attendant « Voir plus », mais reste accessible en faisant défiler dans le lecteur
    });
    if (more) {
      const left = n - limit;
      more.hidden = left <= 0;
      more.textContent = `Voir plus d'extraits (${left} restants)`;
    }
    return n;
  }
  more?.addEventListener('click', () => { limit += STEP; apply(); });
  apply();
</script>
