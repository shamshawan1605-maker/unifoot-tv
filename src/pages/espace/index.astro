    const bandeau = document.createElement('p');
    bandeau.className = 'es__adminbar es__demobar';
    bandeau.textContent = 'Démo : faux compte, rien n\'est enregistré.';
    document.querySelector('.es__wrap')!.prepend(bandeau);
  }

  // ---------- Démarrage ----------
  async function init() {
    const p = new URLSearchParams(location.search);
    if (p.has('admin')) { onglet('stats'); return cle ? admin() : show('admin-cle'); }
    cle = '';
    const t = p.get('t');
    if (t) {
      history.replaceState(null, '', '/espace/');
      const r = await fetch(`${api}?action=entrer&t=${encodeURIComponent(t)}`, { credentials: 'same-origin' });
      if (!r.ok) {
        show('login');
        const m = $('.es__msg'); m.hidden = false; m.textContent = 'Ce lien a expiré ou a déjà servi. Demande-en un nouveau.';
        return;
      }
    }
    await charger();
    const brouillon = soums.find((x) => ['brouillon', 'a_corriger'].includes(x.statut));
    edOuvrir(brouillon || null);
    if (p.get('onglet')) onglet(p.get('onglet')!);
  }

  $<HTMLFormElement>('.es__form:not(.es__cle-form)').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const btn = f.querySelector('button')!;
    const m = $('.es__msg');
    btn.disabled = true;
    const r = await fetch(api, { method: 'POST', body: new URLSearchParams({ action: 'lien', email: (f.elements.namedItem('email') as HTMLInputElement).value }) });
    const d = await r.json().catch(() => ({}));
    m.hidden = false;
    m.textContent = r.ok ? "C'est envoyé ! Si cette adresse est celle d'un contributeur, tu vas recevoir un lien de connexion d'ici une minute (pense à regarder les spams)." : d.message || 'Une erreur est survenue, réessaie.';
    btn.disabled = false;
  });

  $('.es__logout').addEventListener('click', async () => {
    await enregistrer();
    await fetch(api, { method: 'POST', body: new URLSearchParams({ action: 'sortir' }), credentials: 'same-origin' });
    show('login');
  });

  // Facture : infos gardées sur l'appareil, numéro auto, impression
  const ff = $<HTMLFormElement>('.es__fac-form');
  const LS = 'uftv_facture';
  try { const v = JSON.parse(localStorage.getItem(LS) || '{}'); for (const k of ['f_adr', 'f_siret']) if (v[k]) (ff.elements.namedItem(k) as HTMLInputElement).value = v[k]; } catch {}
  (ff.elements.namedItem('f_num') as HTMLInputElement).value = `${new Date().getFullYear()}-001`;
  ff.addEventListener('submit', (e) => {
    e.preventDefault();
    const g = (k: string) => (ff.elements.namedItem(k) as HTMLInputElement).value.trim();
    try { localStorage.setItem(LS, JSON.stringify({ f_adr: g('f_adr'), f_siret: g('f_siret') })); } catch {}
    const f = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-f="${k}"]`).forEach((e2) => (e2.textContent = v));
    const today = new Date().toLocaleDateString('fr-FR');
    const m = euros(parseFloat(g('f_mt').replace(',', '.')) || 0);
    f('nom', g('f_nom')); f('adr', g('f_adr')); f('siret', g('f_siret')); f('num', g('f_num')); f('date', today); f('date2', today); f('mt', m); f('mt2', m);
    $('.es__facture').hidden = false;
  });
  $('.es__print').addEventListener('click', () => { document.body.classList.add('print-facture'); window.print(); document.body.classList.remove('print-facture'); });

  init();
</script>

