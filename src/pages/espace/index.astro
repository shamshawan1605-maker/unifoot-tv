---
// Espace contributeur : connexion par lien e-mail, vues et part des revenus de chaque article (données : /api/espace.php).
import Base from '~/layouts/Base.astro';
import { accord, ACCORD_DATE } from '~/lib/accord';
const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Espace contributeur' }];
---
<Base title="Espace contributeur" description="Tes articles, leurs vues et ta part des revenus." breadcrumbs={crumbs} fond="gris" noindex>
  <div class="papier es">
    <section class="wrap es__wrap">
      <p class="es__kicker"><span class="es__dot"></span>Espace contributeur</p>

      <!-- Chargement -->
      <p class="es__etat" data-vue="charge">Chargement…</p>

      <!-- Connexion -->
      <div class="es__login" data-vue="login" hidden>
        <h1>Ton espace contributeur</h1>
        <p class="es__lead">Tes articles, leurs vues et ce qu'ils te rapportent. Entre l'adresse e-mail que tu nous as donnée : on t'envoie un lien pour te connecter, sans mot de passe.</p>
        <form class="es__form">
          <label class="fld"><span>Ton e-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" required /></label>
          <button class="btn btn--menthe" type="submit">Recevoir mon lien</button>
        </form>
        <p class="es__msg" role="status" hidden></p>
        <p class="es__note">Pas encore contributeur ? <a href="/contributeurs/">Découvre le programme</a>.</p>
      </div>

      <!-- Accord de contribution (première connexion) -->
      <div data-vue="accord" hidden>
        <h1>Bienvenue <span data-k="nom"></span> ! Avant de commencer</h1>
        <p class="es__lead">Lis l'accord de contribution : il explique ce que tu peux publier, tes droits sur tes articles et comment tu es payé. Version du {ACCORD_DATE}.</p>
        <div class="ac__txt">
          {accord.map((a, i) => <section><h2>{i + 1}. {a.t}</h2>{a.p.map((x) => <p>{x}</p>)}</section>)}
        </div>
        <label class="ed__chk ac__chk"><input type="checkbox" class="ac__ok" /> J'ai lu l'accord de contribution et la charte, et je les accepte.</label>
        <button type="button" class="btn btn--menthe ac__btn" disabled>J'accepte et j'entre dans mon espace</button>
      </div>

      <!-- Admin : clé -->
      <div class="es__login" data-vue="admin-cle" hidden>
        <h1>Mode admin</h1>
        <form class="es__form es__cle-form">
          <label class="fld"><span>Clé admin</span><input name="cle" type="password" autocomplete="off" required /></label>
          <button class="btn btn--menthe" type="submit">Entrer</button>
        </form>
        <p class="es__msg es__cle-msg" role="status" hidden></p>
      </div>

      <!-- Admin : vue d'ensemble -->
      <div data-vue="admin" hidden>
        <div class="es__head"><h1>Rédaction · admin</h1><button type="button" class="es__out es__admin-out">Quitter le mode admin</button></div>
        <h2>Contributeurs</h2>
        <div class="es__scroll"><table class="es__table es__adm-contrib"><thead><tr><th>Nom</th><th class="num">Vues</th><th class="num">Cagnotte</th><th class="num">À relire</th><th></th></tr></thead><tbody></tbody></table></div>
        <p class="es__vide es__adm-vide" hidden>Aucun contributeur pour l'instant.</p>
        <h2>Candidatures</h2>
        <ul class="es__soum es__adm-cand"></ul>
        <p class="es__vide es__adm-cand-vide" hidden>Aucune candidature pour l'instant.</p>
        <h2>Articles reçus</h2>
        <ul class="es__soum es__adm-soum"></ul>
        <p class="es__vide es__adm-soum-vide" hidden>Aucun article reçu pour l'instant.</p>
      </div>

      <!-- Admin : lecture d'un article -->
      <div data-vue="lecture" hidden>
        <button type="button" class="es__back">← Retour</button>
        <p class="es__badge-l"></p>
        <h1 class="lc__titre"></h1>
        <p class="lc__meta"></p>
        <p class="lc__chapo"></p>
        <div class="lc__photos"></div>
        <div class="lc__texte"></div>
        <p class="lc__source"></p>
        <button type="button" class="btn lc__apercu">Voir l'aperçu comme sur le site</button>
        <form class="es__decision">
          <h2>Décision</h2>
          <label class="fld"><span>Retour au contributeur (visible dans son espace et envoyé par mail)</span><textarea name="retour" rows="4"></textarea></label>
          <label class="fld"><span>Lien de l'article publié (si publié)</span><input name="lien" placeholder="https://unifoottv.fr/actualites/…" /></label>
          <div class="es__btns">
            <button class="btn" type="button" data-st="en_relecture">En relecture</button>
            <button class="btn" type="button" data-st="a_corriger">À corriger</button>
            <button class="btn btn--menthe" type="button" data-st="publie">Publié</button>
            <button class="btn" type="button" data-st="refuse">Refuser</button>
          </div>
          <p class="es__msg es__dec-msg" role="status" hidden></p>
        </form>
      </div>

      <!-- Tableau de bord -->
      <div class="es__tb" data-vue="tb" hidden>
        <p class="es__adminbar" hidden>Mode admin : tu vois l'espace de <b data-k="nomcomplet"></b> exactement comme lui. <button type="button" class="es__back es__back-adm">← Retour à la rédaction</button></p>
        <div class="es__head">
          <h1>Salut <span data-k="nom"></span> 👋</h1>
          <button type="button" class="es__out es__logout">Se déconnecter</button>
        </div>

        <nav class="es__tabs" role="tablist">
          <button type="button" role="tab" data-tab="stats" aria-selected="true">Tableau de bord</button>
          <button type="button" role="tab" data-tab="ecrire">✍️ Écrire</button>
          <button type="button" role="tab" data-tab="mes">Mes articles <span class="es__count" data-k="nb_soum"></span></button>
          <button type="button" role="tab" data-tab="profil">Mon profil</button>
        </nav>

        <!-- Onglet : profil -->
        <div data-panel="profil" hidden>
          <form class="ed pr">
            <p class="es__lead">C'est ta page auteur publique<span class="pr__dispo"> : <a class="pr__lien" href="#" target="_blank">voir ma page</a></span><span class="pr__bientot"> (elle sera en ligne dès ton premier article publié)</span>. Ton nom est cliquable sous chacun de tes articles.</p>
            <div class="pr__photo"><img alt="" class="pr__img" /><label class="btn ed__add">Changer ma photo<input type="file" accept="image/*" hidden /></label></div>
            <label class="fld"><span>Ta bio (2 à 3 phrases : qui tu es, ce que tu suis)</span><textarea name="bio" rows="3" maxlength="400"></textarea></label>
            <label class="fld"><span>Ta région</span><input name="region" maxlength="80" /></label>
            <div class="ed__grid">
              <label class="fld"><span>Instagram</span><input name="instagram" placeholder="instagram.com/ton-compte" /></label>
              <label class="fld"><span>X</span><input name="x" placeholder="x.com/ton-compte" /></label>
              <label class="fld"><span>LinkedIn</span><input name="linkedin" placeholder="linkedin.com/in/…" /></label>
              <label class="fld"><span>Site ou portfolio</span><input name="site" /></label>
            </div>
            <div class="es__btns"><button class="btn btn--menthe" type="submit">Enregistrer mon profil</button></div>
            <p class="es__msg pr__msg" role="status" hidden></p>
          </form>
        </div>

        <!-- Onglet : écrire -->
        <div data-panel="ecrire" hidden>
          <form class="ed ed__form">
            <p class="ed__etat" aria-live="polite"></p>
            <div class="ed__retour" hidden><strong>À corriger :</strong> <span></span></div>
            <label class="fld"><span>Titre</span><input name="titre" maxlength="160" placeholder="Ex. : Le FC Machin s'offre le leader au bout du suspense" /></label>
            <label class="fld"><span>Chapô (1 à 2 phrases qui résument)</span><textarea name="chapo" rows="2" maxlength="400"></textarea></label>
            <div class="fld"><span>Ton article</span>
              <div class="ed__tool"><button type="button" data-ins="h">Intertitre</button><button type="button" data-ins="b"><b>Gras</b></button><span class="ed__mots"></span></div>
              <textarea name="texte" rows="16" placeholder="Qui, quoi, où, quand. Des faits, des citations. 250 à 600 mots."></textarea>
            </div>
            <div class="ed__grid">
              <label class="fld"><span>Région</span><input name="region" maxlength="80" /></label>
              <label class="fld"><span>Club(s) concerné(s)</span><input name="club" maxlength="120" /></label>
            </div>
            <label class="fld"><span>Ta source (club, district, témoin direct, lien…)</span><input name="source" maxlength="300" /></label>
            <label class="ed__chk"><input type="checkbox" name="propre_club" /> J'écris sur mon propre club</label>

            <div class="fld"><span>Photos (1 à 5, 12 Mo max chacune)</span>
              <div class="ed__photos"></div>
              <label class="btn ed__add">+ Ajouter des photos<input type="file" accept="image/*" multiple hidden /></label>
            </div>
            <label class="ed__chk"><input type="checkbox" name="accord_photo" /> Ces photos sont de moi ou j'ai l'accord écrit du photographe. Pour un mineur reconnaissable, j'ai l'accord des parents.</label>

            <div class="es__btns">
              <button class="btn ed__apercu" type="button">👁 Aperçu sur le site</button>
              <button class="btn btn--menthe ed__send" type="button">Envoyer à la rédaction</button>
              <button class="btn ed__new" type="button">Nouvel article</button>
            </div>
            <p class="es__msg ed__msg" role="status" hidden></p>
          </form>
        </div>

        <!-- Onglet : mes articles -->
        <div data-panel="mes" hidden>
          <ul class="es__soum es__mes"></ul>
          <p class="es__vide es__mes-vide" hidden>Pas encore d'article. Va dans « Écrire » pour te lancer !</p>
        </div>

        <!-- Onglet : tableau de bord -->
        <div data-panel="stats">
        <div class="es__palier"><span class="es__palier-n" data-k="palier"></span><span data-k="palier_txt"></span></div>
        <div class="es__tiles">
          <div class="es__tile"><span>Vues au total</span><strong data-k="vues"></strong></div>
          <div class="es__tile"><span>Vues ce mois-ci</span><strong data-k="vues_mois"></strong></div>
          <div class="es__tile"><span>Revenus générés</span><strong data-k="revenus"></strong></div>
          <div class="es__tile es__tile--main"><span>Ta part (<b data-k="pourcent"></b> %)</span><strong data-k="part"></strong></div>
        </div>

        <div class="es__cagnotte">
          <div class="es__cag-head"><span>Ta cagnotte</span><strong data-k="solde"></strong></div>
          <div class="es__bar" role="progressbar" aria-valuemin="0" aria-valuemax="50"><span class="es__fill"></span></div>
          <p class="es__cag-txt" data-k="cagnotte_txt"></p>
          <p class="es__cag-sub">Déjà versé depuis le début : <b data-k="verse"></b></p>
        </div>
        <p class="es__attente" hidden></p>

        <div class="cl">
          <div class="cl__head"><h2>🏆 Classement du mois</h2><span class="cl__mois"></span></div>
          <p class="cl__moi"></p>
          <ol class="cl__liste"></ol>
          <p class="cl__vide" hidden>Le classement démarre avec les premiers articles publiés du mois.</p>
          <p class="cl__prix"><strong>Le n°1 du mois</strong> devient « Correspondant du mois » : mis en avant sur la page d'accueil, en story sur tous nos réseaux et annoncé dans Kick in the Foot.</p>
          <p class="cl__prec" hidden></p>
        </div>

        <h2>Tes articles publiés</h2>
        <div class="es__scroll">
          <table class="es__table">
            <thead><tr><th>Article</th><th>Publié le</th><th class="num">Vues</th><th class="num">Ce mois</th><th class="num">Revenus</th><th class="num">Ta part</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <p class="es__vide es__vide-pub" hidden>Tu n'as pas encore d'article publié. Va dans l'onglet « Écrire » pour te lancer.</p>

        <h2>Comment tu es payé</h2>
        <ul class="es__calc">
          <li><strong>Seuil :</strong> versement dès que ta cagnotte atteint 50 €, ou une fois par an en juin si tu préfères.</li>
          <li><strong>Sur facture :</strong> il faut le statut d'auto-entrepreneur (création gratuite sur <a href="https://autoentrepreneur.urssaf.fr" target="_blank" rel="noopener">autoentrepreneur.urssaf.fr</a>). Tu nous envoies ta facture, on te fait un virement.</li>
          <li><strong>Pas de statut ?</strong> Ta cagnotte reste en attente, sans limite de temps.</li>
        </ul>

        <details class="es__fac">
          <summary>Préparer ma facture</summary>
          <p class="es__fac-intro">Remplis tes infos une fois (elles restent sur ton appareil), puis imprime ou enregistre en PDF et envoie-la à contact@unifoottv.fr.</p>
          <form class="es__fac-form">
            <label class="fld"><span>Nom et prénom</span><input name="f_nom" required /></label>
            <label class="fld"><span>Adresse</span><input name="f_adr" required /></label>
            <label class="fld"><span>SIRET</span><input name="f_siret" inputmode="numeric" required /></label>
            <label class="fld"><span>N° de facture</span><input name="f_num" required /></label>
            <label class="fld"><span>Montant (€)</span><input name="f_mt" inputmode="decimal" required /></label>
            <button class="btn btn--menthe" type="submit">Afficher et imprimer</button>
          </form>
          <div class="es__facture" hidden>
            <div class="fa__top"><div><strong data-f="nom"></strong><br /><span data-f="adr"></span><br />SIRET <span data-f="siret"></span></div><div class="fa__r"><strong>FACTURE <span data-f="num"></span></strong><br />Date : <span data-f="date"></span></div></div>
            <p><strong>Client</strong><br />UNIFOOT SASU (UNIFOOT TV)<br />9 rue des Colonnes, 75002 Paris<br />SIRET 978 722 023 00014</p>
            <table class="fa__t"><thead><tr><th>Désignation</th><th class="num">Montant</th></tr></thead>
              <tbody><tr><td>Rémunération des contributions publiées sur unifoottv.fr (part des revenus publicitaires) jusqu'au <span data-f="date2"></span></td><td class="num" data-f="mt"></td></tr></tbody>
              <tfoot><tr><th>Total à payer</th><th class="num" data-f="mt2"></th></tr></tfoot></table>
            <p class="fa__m">TVA non applicable, art. 293 B du CGI. Paiement par virement à réception.</p>
            <button type="button" class="btn btn--menthe es__print">Imprimer / PDF</button>
          </div>
        </details>

        <h2>Comment c'est calculé</h2>
        <ul class="es__calc">
          <li><strong>Vues :</strong> une vue par lecteur, par article et par jour. Les robots ne sont pas comptés.</li>
          <li><strong>Revenus :</strong> vues du mois × revenu publicitaire réel du mois pour 1 000 vues, relevé dans le compte Google AdSense d'UNIFOOT TV.</li>
          <li><strong>Ta part :</strong> <span data-k="pourcent2"></span> % des revenus de tes articles, versée une fois que Google a payé UNIFOOT TV pour le mois.</li>
          <li>Les vues du mois en cours sont comptées en direct ; leurs revenus apparaissent quand le mois est clôturé (début du mois suivant).</li>
        </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const api = '/api/espace.php';
  const euros = (n: number) => n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
  const nb = (n: number) => n.toLocaleString('fr-FR');
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const vues = document.querySelectorAll<HTMLElement>('[data-vue]');
  const show = (v: string) => { vues.forEach((el) => (el.hidden = el.dataset.vue !== v)); window.scrollTo(0, 0); };
  const set = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-k="${k}"]`).forEach((el) => (el.textContent = v));
  const date = (d: string) => !d ? '' : new Date(d.length === 10 ? d + 'T12:00:00' : d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
  const el = (tag: string, props: Record<string, any> = {}, ...kids: (Node | string)[]) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
  const STATUTS: Record<string, string> = { brouillon: 'Brouillon', envoye: 'Envoyé', en_relecture: 'En relecture', a_corriger: 'À corriger', publie: 'Publié', refuse: 'Refusé' };
  const badge = (st: string) => el('span', { className: `es__badge es__badge--${st}`, textContent: STATUTS[st] || st });

  // Mode admin : clé gardée pour la session du navigateur uniquement
  let cle = ''; try { cle = sessionStorage.getItem('uftv_cle') || ''; } catch {}
  let vueAdmin: string | null = null; // e-mail du contributeur regardé en mode admin
  const q = (params: Record<string, string>) => api + '?' + new URLSearchParams(cle ? { ...params, k: cle } : params);
  const photoUrl = (id: string, f: string) => q({ action: 'photo_voir', id, f });

  // ---------- Onglets ----------
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  function onglet(t: string) {
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
    panels.forEach((p) => (p.hidden = p.dataset.panel !== t));
  }
  tabs.forEach((b) => b.addEventListener('click', () => onglet(b.dataset.tab!)));

  // ---------- Tableau de bord ----------
  let soums: any[] = [];
  async function charger(as?: string) {
    const r = await fetch(as ? q({ action: 'moi', as }) : `${api}?action=moi`, { credentials: 'same-origin' });
    if (!r.ok) return show('login');
    const d = await r.json();
    vueAdmin = as || null;
    document.querySelector<HTMLElement>('.es__adminbar:not(.es__demobar)')!.hidden = !as;
    $('.es__logout').hidden = !!as;
    set('nomcomplet', d.nom);
    set('nom', d.nom.split(' ')[0]);
    set('vues', nb(d.totaux.vues));
    set('vues_mois', nb(d.totaux.vues_mois));
    set('revenus', euros(d.totaux.revenus));
    set('part', euros(d.totaux.part));
    set('pourcent', String(d.part_pourcent));
    set('pourcent2', String(d.part_pourcent));
    set('verse', euros(d.verse));
    set('solde', euros(d.solde));
    const seuil = d.seuil || 50, pct = Math.min(100, (d.solde / seuil) * 100);
    $('.es__fill').style.width = pct + '%';
    set('cagnotte_txt', d.solde >= seuil ? 'Bravo, tu as atteint le seuil : prépare ta facture ci-dessous et envoie-la nous.' : `Plus que ${euros(seuil - d.solde)} avant ton premier versement de ${euros(seuil)}.`);
    const mt = document.querySelector<HTMLInputElement>('[name=f_mt]'); if (mt) mt.value = d.solde.toFixed(2).replace('.', ',');
    const nm = document.querySelector<HTMLInputElement>('[name=f_nom]'); if (nm && !nm.value) nm.value = d.nom;
    const att = $('.es__attente');
    att.hidden = !(d.totaux.vues_en_attente > 0);
    att.textContent = `${nb(d.totaux.vues_en_attente)} vues en attente de calcul : leurs revenus s'afficheront à la clôture du mois.`;
    const tb = $('.es__table:not(.es__adm-contrib) tbody');
    tb.replaceChildren(...d.articles.map((a: any) => {
      const td = (t: string, cls = '') => el('td', { textContent: t, className: cls });
      return el('tr', {}, el('td', {}, el('a', { href: `/actualites/${a.slug}/`, textContent: a.titre })), td(date(a.date)), td(nb(a.vues), 'num'), td(nb(a.vues_mois), 'num'), td(euros(a.revenus), 'num'), td(euros(a.part), 'num'));
    }));
    $('.es__vide-pub').hidden = d.articles.length > 0;
    $('.es__table:not(.es__adm-contrib)').parentElement!.hidden = d.articles.length === 0;
    soums = d.soumissions || [];
    rendreMes();
    edLock();
    const pf = d.profil || {};
    moiNom = d.nom;
    const pa = pf.palier || { nom: 'Nouveau', manque: 1, prochain: 'Contributeur' };
    set('palier', pa.nom);
    set('palier_txt', pa.prochain ? `Encore ${pa.manque} article${pa.manque > 1 ? 's' : ''} publié${pa.manque > 1 ? 's' : ''} pour devenir ${pa.prochain}` + (pa.prochain === 'Correspondant' ? ' (badge et attestation)' : pa.prochain === 'Correspondant confirmé' ? ' (passage dans Kick in the Foot)' : '') + '.' : 'Tu es au plus haut niveau, bravo !');
    const prf = $<HTMLFormElement>('.pr');
    (prf.elements.namedItem('bio') as HTMLTextAreaElement).value = pf.bio || '';
    (prf.elements.namedItem('region') as HTMLInputElement).value = pf.region || '';
    for (const k of ['instagram', 'x', 'linkedin', 'site']) (prf.elements.namedItem(k) as HTMLInputElement).value = pf.liens?.[k] || '';
    $<HTMLAnchorElement>('.pr__lien').href = `/auteurs/${pf.slug}/`;
    $('.pr__dispo').hidden = !(pf.articles > 0); $('.pr__bientot').hidden = pf.articles > 0;
    $<HTMLImageElement>('.pr__img').src = pf.photo ? `${api}?action=auteur_photo&slug=${pf.slug}&v=${Date.now()}` : '/brand/logo-480.png';
    prf.querySelectorAll<HTMLInputElement>('input, textarea, button').forEach((i) => (i.disabled = !!as));
    const cm = d.classement;
    $('.cl__moi').textContent = cm && cm.vues > 0 ? (cm.rang === 1 ? `Tu es 1er ce mois-ci avec ${nb(cm.vues)} vues. Garde ta place !` : `Tu es ${cm.rang}e sur ${cm.total} avec ${nb(cm.vues)} vues, à ${nb(cm.devant)} vues de la place au-dessus.`) : 'Publie un article ce mois-ci pour entrer dans le classement.';
    chargerClassement(pf.slug);
    if (!as && !d.accord) return show('accord');
    show('tb');
  }
  let moiNom = '';
  async function chargerClassement(monSlug: string) {
    const r = await fetch(`${api}?action=classement`); if (!r.ok) return;
    const c = await r.json();
    $('.cl__mois').textContent = new Date(c.mois + '-15').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
    $('.cl__liste').replaceChildren(...c.top.map((x: any) => el('li', { className: 'cl__l' + (x.slug === monSlug ? ' cl__l--moi' : '') },
      el('span', { className: 'cl__r', textContent: x.rang === 1 ? '🥇' : x.rang === 2 ? '🥈' : x.rang === 3 ? '🥉' : String(x.rang) }),
      el('span', { className: 'cl__n' }, el('strong', { textContent: x.nom }), el('small', { textContent: x.region || '' })),
      el('span', { className: 'cl__v', textContent: nb(x.vues) + ' vues' }))));
    $('.cl__vide').hidden = c.top.length > 0;
    const g = c.gagnant_precedent;
    $('.cl__prec').hidden = !g;
    if (g) $('.cl__prec').textContent = `Correspondant du mois dernier : ${g.nom} (${nb(g.vues)} vues). Bravo !`;
  }

  // ---------- Mes articles ----------
  function rendreMes() {
    set('nb_soum', soums.length ? `(${soums.length})` : '');
    const ul = $('.es__mes');
