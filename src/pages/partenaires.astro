---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import FormEnhance from '~/components/FormEnhance.astro';
import { audienceHighlights, audienceByNetwork, audienceUpdatedAt } from '@config/audience';
import { partners, offers, offersAreExample, mediaKitUrl } from '@config/partners';
import { invites } from '@config/invites';
const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Partenaires' }];
const [y, m] = audienceUpdatedAt.split('-');
const updated = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date(Number(y), Number(m) - 1, 1));
const num = (v: string) => parseFloat(v.replace(',', '.').replace(/[^\d.]/g, ''));
const maxNet = Math.max(1, ...audienceByNetwork.map((a) => num(a.value)));
const netIcon: Record<string, string> = { TikTok: 'tiktok', Facebook: 'facebook', Instagram: 'instagram', YouTube: 'youtube', X: 'x', LinkedIn: 'linkedin' };
const stats = [...audienceHighlights, { value: `${Math.floor(invites.length / 10) * 10}+`, label: 'invités reçus sur le plateau' }];
const slots = [
  { t: '« Présenté par »', d: "Votre marque en tête d'une émission : Kick in the Foot, Entre 2 ou Au cœur d'une séance.", k: 'show' },
  { t: 'Partenaire de rubrique', d: 'Associez-vous à un thème : formation, arbitrage, éducateurs, bénévoles, parents ou vie des clubs.', k: 'rub' },
  { t: 'Encart dans les contenus', d: "Présent sur chaque actu et chaque page d'épisode.", k: 'enc' },
  { t: "Bandeau d'accueil", d: "La visibilité maximale, sur la page d'accueil du site.", k: 'home' },
];
---
<Base title="Devenir partenaire du foot amateur" description="Associez votre marque au média du football amateur : audience, formules de partenariat et contact. UNIFOOT TV, Kick in the Foot chaque mercredi." breadcrumbs={crumbs}>
  <!-- Bandeau -->
  <section class="ph sombre" aria-labelledby="ph-title">
    <div class="ph__bg" aria-hidden="true"><img src="/photos/p9Acoe81iAE.webp" alt="" width="1600" height="900" decoding="async" fetchpriority="high" /></div>
    <div class="wrap ph__in">
      <p class="ph__kicker"><span></span>Partenariats</p>
      <h1 id="ph-title">Parlez à ceux qui <em>font</em> le foot amateur.</h1>
      <p class="ph__lead">Joueurs, éducateurs, dirigeants, parents : une communauté engagée qui suit l'émission chaque semaine. Votre marque au cœur du terrain.</p>
      <div class="ph__ctas">
        <a class="btn btn--menthe" href="#contact-p">Devenir partenaire</a>
        <a class="btn btn--ghost" href="#offres">Voir les formules</a>
      </div>
      <ul class="ph__chips" aria-label="En bref">
        {audienceHighlights.map((a) => <li><strong>{a.value}</strong><span>{a.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- Audience -->
  <section class="section wrap aud" aria-labelledby="audience">
    <div class:list={["aud__grid", { "aud__grid--solo": audienceByNetwork.length === 0 }]}>
      <div>
        <p class="kick">L'audience</p>
        <h2 id="audience" class="h2b">Une communauté qui regarde, commente et partage.</h2>
        <dl class="aud__big">
          {stats.map((a) => <div><dd data-count>{a.value}</dd><dt>{a.label}</dt></div>)}
        </dl>
      </div>
      {audienceByNetwork.length > 0 && <div class="nets">
        <p class="nets__t">Abonnés par réseau</p>
        <ul>
          {audienceByNetwork.map((a) => (
            <li style={`--w:${Math.round((num(a.value) / maxNet) * 100)}%`}>
              <span class="nets__name">{netIcon[a.network] && <Icon name={netIcon[a.network] as any} size={18} />}{a.network}</span>
              <span class="nets__bar"><i></i></span>
              <strong>{a.value}</strong>
            </li>
          ))}
        </ul>
        <p class="meta">Chiffres de {updated}.</p>
      </div>}
    </div>
  </section>

  <!-- Pourquoi -->
  <section class="section why-s" aria-labelledby="pourquoi">
    <div class="wrap">
      <p class="kick">Pourquoi UNIFOOT TV</p>
      <h2 id="pourquoi" class="h2b">Une visibilité qui a du sens.</h2>
      <ul class="why">
        <li>
          <span class="why__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 19c.6-3.4 3-5.2 6-5.2s5.4 1.8 6 5.2"/><circle cx="17" cy="9" r="2.4"/><path d="M16 13.9c2.5.1 4.3 1.6 4.9 4.6"/></svg></span>
          <h3>Une cible précise</h3>
          <p>Ceux qui font vivre les clubs : joueurs, éducateurs, présidents, bénévoles et parents. Pas une audience au hasard.</p>
        </li>
        <li>
          <span class="why__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="12" rx="2.5"/><path d="M10 9l4.5 2-4.5 2z"/><path d="M8 20h8"/></svg></span>
          <h3>Des contenus qui durent</h3>
          <p>Une émission chaque semaine et des extraits qui tournent sur 9 plateformes pendant des mois.</p>
        </li>
        <li>
          <span class="why__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5.5c0 4.3-3 7.8-7 9.5-4-1.7-7-5.2-7-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/></svg></span>
          <h3>Un média engagé</h3>
          <p>Uniquement des marques du sport et du foot amateur. Pas de paris sportifs, pas d'alcool.</p>
        </li>
      </ul>
    </div>
  </section>

  {partners.length > 0 && (
    <section class="section wrap" aria-labelledby="ils">
      <p class="kick">Ils nous accompagnent</p>
      <h2 id="ils" class="h2b">Nos partenaires</h2>
      <ul class="partners">
        {partners.map((p) => (
          <li class="pcard sombre">
            <a class="pcard__logo" href={p.url} rel="noopener sponsored" target="_blank" aria-label={p.name}>
              {p.logo ? <img src={p.logo} alt="" width="120" height="120" loading="lazy" /> : <span>{p.name}</span>}
            </a>
            <div class="pcard__txt">
              <h3>{p.name}</h3>
              {p.description && <p>{p.description}</p>}
              <a class="pcard__link" href={p.url} rel="noopener sponsored" target="_blank">Découvrir <Icon name="external" size={16} /></a>
            </div>
          </li>
        ))}
        <li class="pcard pcard--free">
          <a href="#contact-p"><span class="pcard__plus" aria-hidden="true">+</span><strong>Votre marque ici</strong><span>Rejoignez l'aventure</span></a>
        </li>
      </ul>
    </section>
  )}

  <!-- Emplacements -->
  <section class="section wrap" aria-labelledby="emplacements">
    <p class="kick">Sur le site</p>
    <h2 id="emplacements" class="h2b">Les emplacements</h2>
    <ul class="slots">
      {slots.map((sl, i) => (
        <li>
          <div class:list={['mock', `mock--${sl.k}`]} aria-hidden="true">
            <span class="mock__bar"></span><span class="mock__hl"></span><span class="mock__a"></span><span class="mock__b"></span><span class="mock__c"></span>
          </div>
          <span class="slots__n">0{i + 1}</span>
          <h3>{sl.t}</h3>
          <p>{sl.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Formules -->
  <section class="section offers-s sombre" aria-labelledby="offres">
    <div class="wrap">
      <p class="kick">Les formules</p>
      <h2 id="offres" class="h2b">Partenariat à la saison.</h2>
      <p class="sub">Chaque formule s'adapte à vos objectifs.{mediaKitUrl && <> <a class="pf__dl" href={mediaKitUrl}>Télécharger le media kit</a></>}</p>
      <ol class="offers">
        {offers.map((o, i) => (
          <li class:list={['offer', { 'offer--top': i === offers.length - 1 }]} style={`--lvl:${i}`}>
            {i === offers.length - 1 && <span class="offer__badge">Le plus complet</span>}
            <span class="offer__gem" aria-hidden="true"></span>
            <h3>{o.name}</h3>
            <p class="offer__pitch">{o.pitch}</p>
            <ul>{o.items.map((it) => <li>{it}</li>)}</ul>
            <a class="offer__cta" href="#contact-p" data-formule={o.name}>Choisir {o.name}</a>
          </li>
        ))}
      </ol>
      {offersAreExample && <p class="example">Détail des formules à titre indicatif : on construit l'offre avec vous.</p>}
    </div>
  </section>

  <!-- Étapes -->
  <section class="section wrap" aria-labelledby="etapes">
    <p class="kick">Comment ça se passe</p>
    <h2 id="etapes" class="h2b">Trois étapes, c'est tout.</h2>
    <ol class="steps">
      <li><span>1</span><h3>On échange</h3><p>Vous nous parlez de votre marque et de vos objectifs.</p></li>
      <li><span>2</span><h3>On vous propose</h3><p>Une offre sur mesure sous 48 heures ouvrées.</p></li>
      <li><span>3</span><h3>On lance</h3><p>Votre marque à l'antenne et sur le site, avec un bilan des résultats.</p></li>
    </ol>
  </section>

  <!-- Contact -->
  <section class="section wrap" aria-labelledby="contact-p" id="contact">
    <div class="pf">
      <div class="pf__side sombre">
        <img class="pf__mic" src="/brand/micro-unifoot.webp" alt="" width="200" height="200" loading="lazy" aria-hidden="true" />
        <h2 id="contact-p" class="h2b">Parlons de votre projet</h2>
        <p>Laissez vos coordonnées, on vous répond sous 48 heures ouvrées avec une proposition.</p>
        <p class="pf__mail">Ou écrivez-nous : <a href="mailto:contact@unifoottv.fr">contact@unifoottv.fr</a></p>
      </div>
      <form class="form" name="partenaires" method="POST" action="/api/form.php" data-enhance data-success="Merci, votre demande est bien arrivée. On vous répond sous 48 heures ouvrées.">
        <input type="hidden" name="form-name" value="partenaires" />
        <p class="hp"><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form-body form">
          <div class="row">
            <div class="field"><label for="pa-nom">Nom</label><input id="pa-nom" name="nom" autocomplete="name" required /></div>
            <div class="field"><label for="pa-org">Entreprise ou structure</label><input id="pa-org" name="entreprise" autocomplete="organization" required /></div>
          </div>
          <div class="row">
            <div class="field"><label for="pa-email">E-mail professionnel</label><input id="pa-email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="pa-tel">Téléphone <span class="opt">(facultatif)</span></label><input id="pa-tel" name="telephone" type="tel" autocomplete="tel" /></div>
          </div>
          <div class="field">
            <label for="pa-formule">Formule envisagée</label>
            <select id="pa-formule" name="formule"><option value="">Je ne sais pas encore</option>{offers.map((o) => <option>{o.name}</option>)}</select>
          </div>
          <div class="field"><label for="pa-msg">Votre projet</label><textarea id="pa-msg" name="message" required minlength="10"></textarea></div>
          <label class="check"><input type="checkbox" name="consentement" value="oui" required /><span>J'accepte qu'UNIFOOT TV utilise ces informations pour me recontacter. Voir la <a href="/confidentialite/">politique de confidentialité</a>.</span></label>
          <div><button class="btn btn--ink" type="submit">Envoyer la demande</button></div>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
  <FormEnhance />
</Base>
<script>
  // Chiffres qui défilent + barres qui se remplissent à l'arrivée
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nets = document.querySelector('.nets');
  if (!('IntersectionObserver' in window) || reduce) nets?.classList.add('is-in');
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      if (el.classList.contains('nets')) { el.classList.add('is-in'); return; }
      const final = el.textContent || '';
      const m = final.match(/^(\d+)(?:,(\d+))?(.*)$/);
      if (!m) return;
      const dec = m[2] ? m[2].length : 0, target = Number(m[1] + (m[2] ? '.' + m[2] : '')), rest = m[3];
      el.style.minWidth = `${el.offsetWidth}px`;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 1600), ease = 1 - Math.pow(1 - k, 3);
        el.textContent = (target * ease).toFixed(dec).replace('.', ',') + rest;
        if (k < 1) requestAnimationFrame(step); else el.textContent = final;
      };
      requestAnimationFrame(step);
    }), { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach((n) => io.observe(n));
    if (nets) io.observe(nets);
  }
  // « Choisir Gold » préremplit la formule du formulaire
  document.querySelectorAll<HTMLAnchorElement>('[data-formule]').forEach((a) => a.addEventListener('click', () => {
    const sel = document.getElementById('pa-formule') as HTMLSelectElement | null;
    if (sel) sel.value = a.dataset.formule || '';
  }));
</script>
<style>
  .kick { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 0.6rem; font: 800 0.75rem/1 var(--f-info); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .kick::before { content: ''; width: 1.4rem; height: 2px; background: currentColor; }
  .h2b { font: 800 clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem)/1.08 var(--f-titre); letter-spacing: -0.02em; max-width: 22ch; }

  /* Bandeau */
  .ph { position: relative; overflow: hidden; background: var(--marine); color: #fff; isolation: isolate; }
  .ph__bg { position: absolute; inset: 0; z-index: -1; }
  .ph__bg img { position: absolute; right: 0; top: 0; height: 100%; width: 100%; object-fit: cover; object-position: 60% 40%; }
  .ph__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--marine) 0%, rgb(10 12 44 / 0.88) 35%, rgb(10 12 44 / 0.2) 65%, transparent), linear-gradient(0deg, var(--marine), transparent 30%); }
  @media (max-width: 48rem) { .ph__bg::after { background: linear-gradient(0deg, var(--marine) 30%, rgb(10 12 44 / 0.75)); } }
  .ph__in { padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .ph__kicker { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.8rem; border-radius: 99px; background: rgb(34 195 211 / 0.15); border: 1px solid rgb(34 195 211 / 0.4); color: var(--menthe); font: 800 0.75rem/1 var(--f-info); text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 1.1rem; }
  .ph__kicker span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--menthe); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgb(34 195 211 / 0.6); } 50% { box-shadow: 0 0 0 7px rgb(34 195 211 / 0); } }
  .ph h1 { font: 800 clamp(2.4rem, 1.4rem + 4vw, 4.6rem)/1 var(--f-titre); letter-spacing: -0.03em; max-width: 14ch; color: #fff; }
  .ph h1 em { font-style: normal; color: var(--menthe); }
  .ph__lead { font-size: var(--t-l); line-height: 1.5; color: #c9cde6; max-width: 44ch; margin: 1.2rem 0 0; }
  .ph__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.8rem; }
  .ph__chips { list-style: none; margin: 2.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ph__chips li { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.75rem 1.1rem; border-radius: 14px; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.14); backdrop-filter: blur(8px); }
  .ph__chips strong { font: 800 1.6rem/1 var(--f-titre); color: var(--menthe); white-space: nowrap; }
  .ph__chips span { font: 600 0.875rem/1.2 var(--f-info); color: #dfe2f2; }

  /* Audience */
  .aud__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 60rem) { .aud__grid { grid-template-columns: 1.15fr 1fr; gap: 4rem; } }
  .aud__grid--solo { grid-template-columns: 1fr !important; }
  .aud__big { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0 0; }
  .aud__big div { padding-top: 1rem; border-top: 3px solid var(--menthe); }
  .aud__big dd { margin: 0; font: 800 clamp(2rem, 1.4rem + 2.4vw, 3.4rem)/1 var(--f-titre); letter-spacing: -0.03em; color: var(--bleu); white-space: nowrap; }
  .aud__big dt { font: 600 var(--t-s)/1.3 var(--f-info); color: var(--texte-2); margin-top: 0.5rem; }
  @media (max-width: 30rem) { .aud__big { grid-template-columns: 1fr; } }
  .nets { padding: 1.6rem; border-radius: 20px; background: var(--fond-2); border: 1px solid var(--trait); }
  .nets__t { font: 800 0.8125rem/1 var(--f-info); text-transform: uppercase; letter-spacing: 0.08em; color: var(--texte-2); margin: 0 0 1.2rem; }
  .nets ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .nets li { display: grid; grid-template-columns: 7.5rem 1fr 3.5rem; align-items: center; gap: 0.75rem; }
  .nets__name { display: inline-flex; align-items: center; gap: 0.5rem; font: 700 0.9375rem/1 var(--f-info); }
  .nets__bar { height: 0.7rem; border-radius: 99px; background: var(--surface); overflow: hidden; }
  .nets__bar i { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--bleu), var(--menthe)); transition: width 1.2s cubic-bezier(.2,.7,.2,1); }
  .nets li:nth-child(2) i { transition-delay: .1s; } .nets li:nth-child(3) i { transition-delay: .2s; } .nets li:nth-child(4) i { transition-delay: .3s; }
  .nets.is-in .nets__bar i { width: var(--w); }
  .nets strong { font: 800 1.125rem/1 var(--f-titre); text-align: right; }
  .nets .meta { margin: 1.2rem 0 0; }

  /* Pourquoi */
  .why-s { background: var(--fond-2); }
  .why { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .why li { padding: 1.6rem; border-radius: 20px; background: var(--fond); border: 1px solid var(--trait); transition: transform .25s ease, box-shadow .25s ease, border-color .25s; }
  .why li:hover { transform: translateY(-4px); border-color: var(--menthe); box-shadow: 0 18px 40px -20px rgb(10 12 44 / 0.35); }
  .why__ic { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 14px; background: var(--marine); color: var(--menthe); margin-bottom: 1.1rem; }
  .why__ic svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .why h3 { font: 800 1.25rem/1.2 var(--f-titre); }
  .why p { color: var(--texte-2); margin: 0.5rem 0 0; line-height: 1.55; }

  /* Partenaires */
  .partners { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .pcard { display: grid; grid-template-columns: auto 1fr; gap: 1.4rem; align-items: center; padding: 1.6rem; border-radius: 20px; background: radial-gradient(120% 120% at 0% 0%, rgb(34 195 211 / 0.22), transparent 55%), var(--marine); color: #fff; }
  .pcard__logo { display: grid; place-items: center; width: 6.5rem; height: 6.5rem; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6px rgb(255 255 255 / 0.08); transition: transform .3s ease; }
  .pcard__logo:hover { transform: rotate(-6deg) scale(1.05); }
  .pcard__logo img { width: 80%; height: auto; }
  .pcard h3 { font: 800 1.35rem/1.15 var(--f-titre); color: #fff; }
  .pcard p { color: #c9cde6; margin: 0.4rem 0 0.8rem; font-size: var(--t-s); line-height: 1.5; }
  .pcard__link { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--menthe); font-weight: 800; text-decoration: none; }
  .pcard__link:hover { text-decoration: underline; }
  .pcard--free { display: block; padding: 0; background: none; border: 2px dashed var(--trait); color: var(--texte); }
  .pcard--free a { display: grid; justify-items: center; align-content: center; gap: 0.35rem; height: 100%; min-height: 9rem; padding: 1.5rem; text-decoration: none; border-radius: 18px; transition: background .2s, border-color .2s; }
  .pcard--free:hover { border-color: var(--menthe); }
  .pcard--free a:hover { background: var(--fond-2); }
  .pcard__plus { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--marine); color: var(--menthe); font: 800 1.5rem/1 var(--f-titre); }
  .pcard--free strong { font: 800 1.1rem/1.2 var(--f-titre); }
  .pcard--free span:last-child { color: var(--accent); font-size: var(--t-s); font-weight: 600; }

  /* Emplacements */
  .slots { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .slots li { position: relative; padding: 1.2rem 1.2rem 1.4rem; border-radius: 20px; border: 1px solid var(--trait); background: var(--fond); transition: transform .25s ease, box-shadow .25s ease; }
  .slots li:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -20px rgb(10 12 44 / 0.35); }
  .slots__n { font: 800 0.8125rem/1 var(--f-info); color: var(--accent); letter-spacing: 0.08em; }
  .slots h3 { font: 800 1.125rem/1.25 var(--f-titre); margin-top: 0.4rem; }
  .slots p { color: var(--texte-2); font-size: var(--t-s); margin: 0.4rem 0 0; line-height: 1.5; }
  /* Mini-maquette de page, la zone du partenaire en turquoise */
  .mock { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; background: var(--fond-2); border: 1px solid var(--trait); margin-bottom: 1rem; overflow: hidden; }
  .mock span { position: absolute; border-radius: 4px; background: var(--surface); }
  .mock__bar { left: 0; right: 0; top: 0; height: 12%; border-radius: 0 !important; background: var(--marine) !important; }
